<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002-create-account" author="admin">

        <createTable tableName="account">

            <column name="idaccount" type="INTEGER" autoIncrement="true">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_account"
                        nullable="false"/>
            </column>

            <column name="account" type="VARCHAR(100)"/>

            <column name="accountname" type="VARCHAR(100)"/>

            <column name="creationdate" type="TIMESTAMP"/>


        </createTable>

    </changeSet>

</databaseChangeLog>